# Development environment — local backend / LAN
APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Auth API (port 8080)
EXPO_PUBLIC_AUTH_API_URL=http://192.168.1.4
EXPO_PUBLIC_AUTH_API_PORT=8080

# Main app API (port 8081 in local setup)
EXPO_PUBLIC_API_URL=http://192.168.1.4
EXPO_PUBLIC_API_PORT=8081

# Streaming API (port 8082)
EXPO_PUBLIC_STREAMING_URL=http://192.168.1.4
EXPO_PUBLIC_STREAMING_URL_PORT=8082

EXPO_PUBLIC_API_V1_PATH=/api/v1
EXPO_PUBLIC_API_V1_STREAM_PATH=/api/v1/stream

# Google OAuth (set in .env.local — do not commit secrets)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=585318197648-fhuf7klu5tut9gbrro9mosvpha1q3ijq.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
